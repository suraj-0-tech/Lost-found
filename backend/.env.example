# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/lost_found_portal

# Use a long random string in production (e.g. output of: openssl rand -hex 32)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
